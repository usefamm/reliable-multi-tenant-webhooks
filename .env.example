# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=info
# Pretty logs when a human runs the service locally. Compose leaves this unset:
# JSON lines are what a log pipeline (and correlation by requestId) consumes.
LOG_PRETTY=1

# ---- PostgreSQL ----
# In Docker Compose these point at the `postgres` service, e.g.
#   DATABASE_URL=postgres://webhook:webhook@postgres:5432/webhook
DATABASE_URL=postgres://webhook:webhook@127.0.0.1:5432/webhook
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=webhook
PGPASSWORD=webhook
PGDATABASE=webhook

# ---- API server ----
API_PORT=3000

# ---- Workers ----
# Two independent worker processes. WORKER_NAME distinguishes them for lease ownership.
WORKER_NAME=worker-a
WORKER_CONCURRENCY=4
WORKER_LEASE_TTL_MS=30000
WORKER_POLL_INTERVAL_MS=250
WORKER_CLAIM_BATCH_SIZE=4
WORKER_SHUTDOWN_GRACE_MS=5000

# ---- Outbound webhook client ----
WEBHOOK_TIMEOUT_MS=2000
WEBHOOK_MAX_RESPONSE_BYTES=4096
# SSRF defence, owned by the deployment and NEVER by the event caller.
# Comma-separated host or host:port list; empty means "only what the endpoints
# table says". In production set this to your customers' receiver hosts.
WEBHOOK_ALLOWED_HOSTS=

# ---- Retry policy ----
RETRY_MAX_ATTEMPTS_PER_CYCLE=5
RETRY_BACKOFF_BASE_MS=1000
RETRY_JITTER_MAX_MS=250
RETRY_AFTER_CAP_MS=60000

# ---- Receiver ----
RECEIVER_PORT=4000
RECEIVER_TIMESTAMP_TOLERANCE_SEC=300
# Base URL the deterministic seed uses to build each endpoint's destination URL.
# Destinations are deployment-owned configuration written once to the endpoints
# table - an event caller can never supply or replace one. In Compose this is
# http://receiver:4000 so workers reach the service by name on the shared network.
RECEIVER_BASE_URL=http://127.0.0.1:4000
# Gates the receiver's TEST-ONLY failure-mode control surface (/__control/*).
# Tests need it; a production-like receiver must set this to false so failure
# behaviour can never be steered from outside.
RECEIVER_TEST_CONTROLS=1

# ---- Seeded auth tokens (DEVELOPMENT ONLY - never use in production) ----
# These map server-side to tenant identities / operator role.
TENANT_A_TOKEN=dev-token-tenant-a
TENANT_B_TOKEN=dev-token-tenant-b
OPERATOR_TOKEN=dev-token-operator
